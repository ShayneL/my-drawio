        <mxCell id="hnvYmr1mPBXMRoJ_OLv_-12" value="功能性需求：&lt;div&gt;&lt;b&gt;基础功能：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;支持跨多设备进行游戏&lt;/div&gt;&lt;div&gt;&lt;b&gt;象棋玩法逻辑：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;下棋落子的时候需要验证&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;用户大厅匹配功能，匹配等级接近的玩家&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;可以支持撤销功能，每盘棋局每个用户可以撤销3次，需要对方同意&lt;/div&gt;&lt;div&gt;&lt;b&gt;排行榜功能：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: bold; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;总榜、区域排行榜&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-70" y="-97" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="hnvYmr1mPBXMRoJ_OLv_-13" value="非功能性需求：&lt;div&gt;&lt;b&gt;规模性需求：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;支持每天1000w用户的使用&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;同时在线人数100w&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;同时进行中的棋局50w&lt;/div&gt;&lt;div&gt;&lt;b&gt;时效性需求：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;用户下棋过程中的系统响应延迟足够低&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;稳定性需求：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;用户多端设备自动重连&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;服务器运行稳定性&amp;amp;数据可靠性&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
